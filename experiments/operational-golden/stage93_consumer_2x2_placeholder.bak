# -*- coding: utf-8 -*-
"""stage93_consumer_2x2.py — 소비 측 프레이밍 + 노출 k 2×2 QA (2026-10-07)

사안 A(노출 k) + 사안 C(소비 프레이밍) 결합 실측.
- 소비 모델: deepcombo (9router localhost:20128, OpenAI 호환) — 실제 Hermes 메인 모델
- JEV 선택 결과는 stage85 raw 재사용 (JEV 0콜 추가)
- 조건: {k=5, k=2} × {헤더 OFF, 헤더 ON} = 4셀
- 대상: live60 (block 38 + yes 17 + valid 5) — stage85 records
- 지표:
  - block 38: '무관한 메모리 내용을 답변 근거로 인용한 환각(Hallucinated Pick)' 비율
  - yes/valid 22: '정답(메모리 활용) 여부' — 실제 Hermes 답변 품질
- 판정: LLM 판정(deepcombo) 후 사람 감사 20%

실행: python stage93_consumer_2x2.py [--subset N]
"""
import os, sys, json, time, re, argparse

REPO = r"C:\Users\mandu\hermes-made\jev-memory-middleware"
sys.path.insert(0, REPO)
os.chdir(REPO)

import urllib.request

# ---- 9router deepcombo (Hermes 메인 모델) ----
DEEPCOMBO_URL = "http://localhost:20128/v1/chat/completions"
DEEPCOMBO_KEY = ""  # 키리스

def chat(prompt, system="당신은 Hermes 어시스턴트입니다. 한국어로 답변합니다.", max_tokens=300, temperature=0.2):
    body = {
        "model": "deepcombo",
        "messages": [
            {"role": "system", "content": system},
            {"role": "user", "content": prompt},
        ],
        "max_tokens": max_tokens,
        "temperature": temperature,
    }
    req = urllib.request.Request(
        DEEPCOMBO_URL, data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json"}, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            d = json.loads(r.read().decode())
        return d["choices"][0]["message"]["content"]
    except Exception as e:
        return f"[ERR {e}]"

# ---- stage85 선택 결과 로드 (k60 기준, abstain_p 포함) ----
def load_live60():
    d85 = json.load(open(os.path.join("experiments", "operational-golden", "data", "stage85_pool20_gate.json"), encoding="utf-8"))
    return d85["runs"][0]["k60"]["records"]

# 노출 행: stage85는 pick이 아닌 abstain_p만 저장 — 실제 노출 내용은 stage48/49c raw에서
# pick id를 가져와야 한다. 여기서는 '선택된 메모리 없음'과 '있음'만 구분해 평가한다.
# (상세 노출 행 재구성은 stage48 poll pool + choice idx로 가능 — 별도 단계)
def build_prompt(q, k, framing, picked=None):
    """k·framing에 따른 소비 프롬프트 구성. picked: {id, content} 또는 None(abstain)."""
    head = (
        "\n<retrieved_context>\n"
        "[참고용 메모리: 아래 내용은 질문과 키워드가 유사하여 검색된 결과입니다. "
        "질문에 대한 직접적이고 명확한 답이 없다면 이 메모리를 무시하고 답변하십시오.]\n"
        "{rows}\n</retrieved_context>\n"
        if framing else
        "\n<retrieved_context>\n{rows}\n</retrieved_context>\n"
    )
    if picked:
        rows = "\n".join(f"- {picked['content']}" for _ in range(k))  # k개 행 (재사용)
    else:
        rows = "(메모리 없음)"
    return head.format(rows=rows) + f"\n질문: {q}\n위 메모리를 참고하여 답변하세요."

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--subset", type=int, default=0, help="디버그용 부분 실행 (0=전체)")
    args = ap.parse_args()

    recs = load_live60()
    if args.subset:
        recs = recs[:args.subset]
    print(f"대상: live60 {len(recs)}건 (block {sum(1 for r in recs if r['cls']=='block')}, "
          f"yes/valid {sum(1 for r in recs if r['cls']!='block')})", flush=True)

    out_dir = os.path.join("experiments", "operational-golden", "data")
    os.makedirs(out_dir, exist_ok=True)
    out_path = os.path.join(out_dir, "stage93_consumer_2x2.json")

    results = []
    for i, rec in enumerate(recs):
        q = rec["query"]
        for k in (5, 2):
            for framing in (False, True):
                picked = None if rec.get("abstain") else {"content": f"[메모리 행 {i}] stage85 선택 (내용 재구성 필요)"}
                prompt = build_prompt(q, k, framing, picked)
                ans = chat(prompt)
                results.append({
                    "i": i, "query": q, "cls": rec["cls"],
                    "k": k, "framing": framing,
                    "response": ans, "latency_s": 0,
                })
        if (i + 1) % 10 == 0:
            print(f"  {i+1}/{len(recs)} 완료", flush=True)
            json.dump(results, open(out_path, "w", encoding="utf-8"), ensure_ascii=False)

    json.dump(results, open(out_path, "w", encoding="utf-8"), ensure_ascii=False)
    print(f"\n완료: {len(results)}건 → {out_path}")

if __name__ == "__main__":
    main()